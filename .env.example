# Copie para .env (nao commitar o .env). O docker compose le este arquivo automaticamente.
# Uso: docker compose -f docker-compose.local.yml up -d --build

# --- Banco de dados (PostgreSQL) ---
# Postgres no host, acessado de dentro do container:
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/traccar
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Fotos dos dispositivos no AWS S3 (opcional) ---
# Deixe MEDIA_S3_BUCKET vazio para continuar gravando as fotos em disco (/opt/traccar/data/media).
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
# Credenciais de um usuario IAM com s3:PutObject e s3:GetObject nas pastas rastreador/*, rastreadoreplaca/* e odometro/*.
# Em EC2/ECS com IAM Role, deixe vazio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
